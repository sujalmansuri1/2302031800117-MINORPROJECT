<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trdo_cart_delivery_estimates"
              inherit_id="website_sale.cart_lines"
              name="Warehouse Delivery Estimates">
        <xpath expr="//div[@name='o_wsale_cart_line_button_container']" position="after">
            <t t-set="estimates" t-value="website_sale_order._get_warehouse_delivery_estimate()"/>
            <t t-if="estimates and line.id in estimates">
                <t t-set="line_est" t-value="estimates[line.id]"/>
                <div class="trdo-delivery-widget mt-2">
                    <div class="trdo-delivery-title">
                        🚚 Estimated Delivery
                    </div>
                    <t t-foreach="line_est['estimates']" t-as="wh_info">
                        <div class="trdo-wh-row">
                            <span t-att-class="'trdo-wh-status-dot ' + wh_info['status']"/>
                            <div>
                                <div class="trdo-wh-name" t-esc="wh_info['warehouse_name']"/>
                                <div style="font-size:0.72rem;color:#888;" t-esc="wh_info['city']"/>
                            </div>
                            <span t-att-class="'trdo-wh-badge ' + wh_info['status']" t-esc="wh_info['status_label']"/>
                            <div class="trdo-wh-date">
                                📅 <t t-esc="wh_info['ship_date']"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
