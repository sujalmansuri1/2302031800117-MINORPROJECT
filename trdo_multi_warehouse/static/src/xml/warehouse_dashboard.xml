<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="trdo_multi_warehouse.WarehouseDashboard">
    <div class="o_trdo_wh_dashboard">
        <t t-if="state.loading">
            <div class="wh-dash-loading">
                <div class="wh-dash-spinner"/>
                <div class="wh-dash-loading-text">Loading warehouse data…</div>
            </div>
        </t>
        <t t-else="">
            <div class="wh-dash-header">
                <div class="wh-dash-header-left">
                    <div class="wh-dash-logo">🏭</div>
                    <div>
                        <h1 class="wh-dash-title">Warehouse Command Center</h1>
                        <p class="wh-dash-subtitle">
                            <span class="wh-live-dot"/>
                            Live · Last updated <t t-esc="state.lastUpdated"/>
                        </p>
                    </div>
                </div>
                <button
                    class="wh-dash-refresh-btn"
                    t-att-class="state.refreshing ? 'loading' : ''"
                    t-on-click="onRefresh">
                    <span class="spin">⟳</span>
                    <span t-if="state.refreshing">Refreshing…</span>
                    <span t-else="">Refresh</span>
                </button>
            </div>

            <div class="wh-kpi-strip">
                <div class="wh-kpi-card">
                    <div class="wh-kpi-icon indigo">🏭</div>
                    <div>
                        <div class="wh-kpi-val pop" t-esc="state.summary.warehouse_count || 0"/>
                        <div class="wh-kpi-lbl">WAREHOUSES</div>
                    </div>
                </div>
                <div class="wh-kpi-card">
                    <div class="wh-kpi-icon blue">📦</div>
                    <div>
                        <div class="wh-kpi-val pop" t-esc="state.summary.total_products || 0"/>
                        <div class="wh-kpi-lbl">PRODUCTS IN STOCK</div>
                    </div>
                </div>
                <div class="wh-kpi-card">
                    <div class="wh-kpi-icon orange">⏳</div>
                    <div>
                        <div class="wh-kpi-val pop" t-esc="state.summary.total_pending || 0"/>
                        <div class="wh-kpi-lbl">PENDING PICKINGS</div>
                    </div>
                </div>
                <div class="wh-kpi-card">
                    <div class="wh-kpi-icon green">✅</div>
                    <div>
                        <div class="wh-kpi-val pop" t-esc="state.summary.total_done_today || 0"/>
                        <div class="wh-kpi-lbl">DONE TODAY</div>
                    </div>
                </div>
                <div class="wh-kpi-card">
                    <div class="wh-kpi-icon red">🚨</div>
                    <div>
                        <div class="wh-kpi-val pop" t-esc="state.summary.total_overdue || 0"/>
                        <div class="wh-kpi-lbl">OVERDUE PICKINGS</div>
                    </div>
                </div>
            </div>

            <div class="wh-glass-card wh-cards-section">
                <div class="wh-card-title">
                    <div class="wh-card-title-icon accent">🏭</div>
                    Warehouse Overview
                </div>
                <t t-if="state.warehouses.length === 0">
                    <div class="wh-dash-empty">
                        <div class="wh-dash-empty-icon">🏗️</div>
                        <div class="wh-dash-empty-title">No warehouses configured</div>
                        <div>Assign warehouses in Website Settings to get started.</div>
                    </div>
                </t>
                <div class="wh-cards-grid" t-else="">
                    <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                        <div class="wh-card" t-on-click="() => openWarehouseInventory(wh.id)">
                            <div class="wh-card-top">
                                <div>
                                    <div class="wh-card-name" t-esc="wh.name"/>
                                    <div class="wh-card-city" t-esc="wh.city"/>
                                </div>
                                <div class="wh-card-badge" t-esc="wh.code"/>
                            </div>
                            <div class="wh-card-stats">
                                <div class="wh-stat">
                                    <div class="wh-stat-num orange" t-esc="wh.pending"/>
                                    <div class="wh-stat-lbl">Pending</div>
                                </div>
                                <div class="wh-stat">
                                    <div class="wh-stat-num green" t-esc="wh.done_today"/>
                                    <div class="wh-stat-lbl">Done Today</div>
                                </div>
                                <div class="wh-stat">
                                    <div t-att-class="'wh-stat-num ' + (wh.overdue > 0 ? 'red' : 'green')" t-esc="wh.overdue"/>
                                    <div class="wh-stat-lbl">Overdue</div>
                                </div>
                                <div class="wh-stat">
                                    <div class="wh-stat-num" t-esc="wh.product_count"/>
                                    <div class="wh-stat-lbl">Products</div>
                                </div>
                                <div class="wh-stat">
                                    <div class="wh-stat-num" t-esc="wh.total_qty"/>
                                    <div class="wh-stat-lbl">Total Qty</div>
                                </div>
                                <div class="wh-stat">
                                    <div t-att-class="'wh-stat-num ' + (wh.low_stock_count > 0 ? 'red' : 'green')" t-esc="wh.low_stock_count"/>
                                    <div class="wh-stat-lbl">Low Stock</div>
                                </div>
                            </div>
                            <div class="wh-util-bar-wrap">
                                <div class="wh-util-label">
                                    <span>Utilization</span>
                                    <span t-esc="wh.utilization + '%'"/>
                                </div>
                                <div class="wh-util-bar-bg">
                                    <div
                                        t-att-class="'wh-util-bar-fill ' + utilColor(wh.utilization)"
                                        t-att-style="'width:' + wh.utilization + '%'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="wh-dash-body">
                <div class="wh-glass-card">
                    <div class="wh-card-title">
                        <div class="wh-card-title-icon orange">⚠️</div>
                        Low Stock Alerts
                    </div>
                    <t t-if="state.low_stock.length === 0">
                        <div class="wh-dash-empty" style="padding:30px 0">
                            <div class="wh-dash-empty-icon">🟢</div>
                            <div class="wh-dash-empty-title">All products well-stocked!</div>
                        </div>
                    </t>
                    <div class="wh-low-stock-list" t-else="">
                        <t t-foreach="state.low_stock" t-as="item" t-key="item_index">
                            <div class="wh-low-stock-item">
                                <div>
                                    <div class="wh-low-stock-name" t-esc="item.product"/>
                                    <div class="wh-low-stock-wh" t-esc="item.warehouse"/>
                                </div>
                                <div class="wh-low-stock-qty">
                                    <t t-esc="item.on_hand"/> / <t t-esc="item.min_qty"/>
                                </div>
                                <div class="wh-low-stock-bar-bg">
                                    <div class="wh-low-stock-bar-fill"
                                        t-att-style="'width:' + item.pct + '%'"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="wh-glass-card">
                    <div class="wh-card-title">
                        <div class="wh-card-title-icon accent">🔥</div>
                        Top Movers (30 days)
                    </div>
                    <t t-if="state.top_movers.length === 0">
                        <div class="wh-dash-empty" style="padding:30px 0">
                            <div class="wh-dash-empty-icon">📭</div>
                            <div class="wh-dash-empty-title">No stock moves yet</div>
                        </div>
                    </t>
                    <div class="wh-top-movers-list" t-else="">
                        <t t-foreach="state.top_movers" t-as="item" t-key="item_index">
                            <div class="wh-mover-item">
                                <div t-att-class="'wh-mover-rank ' + rankClass(item_index)">
                                    <t t-esc="item_index + 1"/>
                                </div>
                                <div class="wh-mover-name" t-esc="item.name"/>
                                <div class="wh-mover-qty" t-esc="item.qty + ' units'"/>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="wh-glass-card" style="grid-column: 1 / -1">
                    <div class="wh-card-title">
                        <div class="wh-card-title-icon green">🚚</div>
                        Recent Transfers
                    </div>
                    <t t-if="state.recent_transfers.length === 0">
                        <div class="wh-dash-empty" style="padding:30px 0">
                            <div class="wh-dash-empty-icon">📋</div>
                            <div class="wh-dash-empty-title">No recent transfers</div>
                        </div>
                    </t>
                    <div class="wh-transfers-list" t-else="">
                        <t t-foreach="state.recent_transfers" t-as="item" t-key="item_index">
                            <div class="wh-transfer-item">
                                <div class="wh-transfer-dot"/>
                                <div>
                                    <div class="wh-transfer-name" t-esc="item.name"/>
                                    <div class="wh-transfer-meta">
                                        <t t-esc="item.partner || 'Internal'"/>
                                        · <t t-esc="item.product_count"/> product(s)
                                    </div>
                                </div>
                                <div>
                                    <div class="wh-transfer-wh" t-esc="item.warehouse"/>
                                    <div class="wh-transfer-date" t-esc="item.date"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
